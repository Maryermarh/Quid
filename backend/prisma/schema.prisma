generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

enum UserRole {
 EARNER
 CREATOR
}

enum MissionStatus {
 OPEN
 STARTED
 PAUSED
 COMPLETED
 CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum NotificationType {
  SUBMISSION_PAID
  SUBMISSION_REJECTED
}

enum NotificationChannelName {
  IN_APP
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
 id String @id @default(uuid()) @map("id")
 address String @unique @map("address")
 email String? @unique @map("email")
 displayName String? @map("display_name")
 bio String? @map("bio")
 role UserRole @default(EARNER)

 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 // Relationships
 missions Mission[]
 submissions Submission[]
 missionDrafts MissionDraft[]

 @@map("users")
}

model Mission {
 id String @id @default(uuid()) @map("id")
 ownerAddress String @map("owner_address")
 title String @map("title")
 descriptionCid String @map("description_cid")
 metadataCid String @map("metadata_cid")
 metadata Json @map("metadata")
 rewardToken String @map("reward_token")
 rewardAmount String @map("reward_amount")
 maxParticipants Int @default(0) @map("max_participants")
 participantsCount Int @default(0) @map("participants_count")
 status MissionStatus @default(OPEN) @map("status")
 aiSummary String @map("ai_summary")
 onChainId String? @unique @map("on_chain_id")
 indexedFromChain Boolean @default(false) @map("indexed_from_chain")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 owner User @relation(fields: [ownerAddress], references: [address])
 submissions Submission[]

 @@index([ownerAddress])
 @@index([status, createdAt(sort: Desc)])
 @@map("missions")
}

model MissionDraft {
 id String @id @default(uuid()) @map("id")
 ownerAddress String @map("owner_address")
 title String @map("title")
 data Json @map("data")
 publishedAt DateTime? @map("published_at")
 publishedMissionId String? @unique @map("published_mission_id")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 owner User @relation(fields: [ownerAddress], references: [address])

 @@index([ownerAddress, updatedAt])
 @@map("mission_drafts")
}

model Submission {
 id String @id @default(uuid()) @map("id")
 missionId String @map("mission_id")
 hunterAddress String @map("hunter_address")
 ipfsCid String @map("ipfs_cid")
 textPayload String? @map("text_payload")
 sentiment Float? @map("sentiment")
 status SubmissionStatus @default(PENDING) @map("status")
 rejectionReason String? @map("rejection_reason")
 txHash String? @unique @map("tx_hash")
 chainConfirmed Boolean @default(false) @map("chain_confirmed")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")

 mission Mission @relation(fields: [missionId], references: [id])
 hunter User @relation(fields: [hunterAddress], references: [address])

 @@unique([missionId, hunterAddress])
 @@index([hunterAddress])
 @@index([missionId])
 @@map("submissions")
}

model IndexerState {
  id Int @id @default(1) @map("id")
  lastLedger BigInt @map("last_ledger")
  lastCursor String? @map("last_cursor")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("indexer_state")
}

/// Issue #314: an alert queued for a hunter, plus one row per channel
/// describing how the delivery attempt went. Splitting the two keeps a failed
/// webhook from hiding the alert from the in-app channel, and lets the dispatch
/// cron retry a single channel without re-sending the others.
model Notification {
  id String @id @default(uuid()) @map("id")
  recipientAddress String @map("recipient_address")
  type NotificationType @map("type")
  subject String @map("subject")
  body String @map("body")
  payload Json @map("payload")
  missionId String? @map("mission_id")
  submissionId String? @map("submission_id")
  createdAt DateTime @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([recipientAddress, createdAt(sort: Desc)])
  @@index([missionId])
  @@map("notifications")
}

model NotificationDelivery {
  id String @id @default(uuid()) @map("id")
  notificationId String @map("notification_id")
  channel NotificationChannelName @map("channel")
  status NotificationDeliveryStatus @default(PENDING) @map("status")
  attempts Int @default(0) @map("attempts")
  lastError String? @map("last_error")
  deliveredAt DateTime? @map("delivered_at")
  createdAt DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}
